# BetSocial backend configuration.
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored - never commit real credentials.
#
# These are read by application.properties. Supply them however your setup
# prefers: an IntelliJ run configuration's "Environment variables" field, a
# shell `export`, or an .env loader.

# --- Database ---------------------------------------------------------------
# Flyway creates/migrates the schema on startup, so an empty database is fine.
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# --- Firebase ---------------------------------------------------------------
# Service-account JSON used by firebase-admin for push notifications and email
# verification. Defaults to the classpath copy at
# src/main/resources/firebaseAPI.json (gitignored) when left unset.
# For deployment point at a file outside the jar:
#   FIREBASE_CREDENTIALS=file:/etc/betsocial/firebaseAPI.json
#FIREBASE_CREDENTIALS=classpath:firebaseAPI.json
#FIREBASE_DB_URL=https://betsocial-e7e93-default-rtdb.europe-west1.firebasedatabase.app

# --- Mail -------------------------------------------------------------------
# Gmail SMTP, used to send account-verification emails.
# MAIL_PASSWORD is a Google *app password*, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=
