# Copy to deploy/.env on the server and fill in.  cp .env.example .env
#
# .env is gitignored. Every value here is a credential except DOMAIN, and the
# compose file refuses to start rather than defaulting any of them - a server
# that came up with a blank password would be worse than one that did not come
# up at all.

# The hostname Caddy gets a certificate for, without https://.
# Must already point at this machine's public IP. A free DuckDNS subdomain works.
DOMAIN=betsocial.duckdns.org

# Postgres. Nothing else uses this, so make it long and never type it again.
#   openssl rand -base64 32
DB_PASSWORD=

# Creates the 'admin' account with this password on first start.
# Without it no admin is created at all - see Startup.
ADMIN_PASSWORD=

# Gmail SMTP, for verification and password-reset email.
# MAIL_PASSWORD is a Google *app password*, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=

# Firebase Storage, without the gs:// prefix. Media references are only accepted
# if they name an object in this bucket, and files are deleted with their content.
FIREBASE_STORAGE_BUCKET=

# The service-account key, as one line of JSON. The container has no file to
# point at - firebaseAPI.json is gitignored and kept out of the build context,
# because a private key baked into an image travels wherever the image does.
#
# On the server:
#   FIREBASE_CREDENTIALS_JSON=$(jq -c . firebaseAPI.json)
# then paste the result here, in single quotes.
FIREBASE_CREDENTIALS_JSON=
